{
  "manifest_version": 3,
  "name": "GCal Appointment Saver",
  "version": "1.0.0",
  "description": "Paste appointment or contact info into Google Calendar/Contacts — AI parsing creates events and contacts for you.",
  "permissions": [
    "storage",
    "identity"
  ],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://www.googleapis.com/*",
    "https://www.google.com/*",
    "https://html.duckduckgo.com/*"
  ],
  "oauth2": {
    "client_id": "466309922148-kp2pitscaj096nca34chrb5s1vbjqmrh.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/calendar.readonly",
      "https://www.googleapis.com/auth/gmail.readonly"
    ]
  },
  "key": "",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://calendar.google.com/*"],
      "js": ["utils/ics-parser.js", "utils/calendar-url.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://contacts.google.com/*"],
      "js": ["utils/vcf-parser.js", "content-contacts.js"],
      "css": ["content-contacts.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "settings.html",
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
